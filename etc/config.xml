<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <byte8_horizon>
            <general>
                <enabled>1</enabled>
                <api_key/>
                <gateway_url>https://horizon.byte8.io</gateway_url>
            </general>
            <writes>
                <product_attributes/>
                <max_price_change_pct>50</max_price_change_pct>
                <max_bulk_products>50</max_bulk_products>
            </writes>
            <assistant>
                <enabled>0</enabled>
                <knowledge_pages/>
            </assistant>
            <delivery>
                <handling_days>1</handling_days>
                <business_days>1</business_days>
                <transit_windows/>
            </delivery>
        </byte8_horizon>
    </default>
</config>
